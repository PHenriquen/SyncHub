# Embedded local database. The path is resolved from apps/api/prisma/schema.prisma.
DATABASE_URL=file:../../../data/synchub.db

# API
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=generated-by-synchub-one-click-minimum-32-characters
JWT_REFRESH_SECRET=generated-by-synchub-one-click-different-minimum-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1

# GitHub integration. Set the webhook secret to receive live synchronization events.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
